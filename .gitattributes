# 换行符规范：脚本给 Linux 跑，必须是 LF，否则 bash 会报 "bad interpreter: ^M"
* text=auto

*.sh    text eol=lf
*.py    text eol=lf
*.c     text eol=lf
*.h     text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
Makefile text eol=lf

# Windows 脚本保留 CRLF（PowerShell / cmd 更稳）
*.ps1   text eol=crlf
*.cmd   text eol=crlf
*.bat   text eol=crlf

# 二进制
*.png   binary
*.jpg   binary
*.pdf   binary
*.xlsx  binary
